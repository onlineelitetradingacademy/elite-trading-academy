# ============================================
# ELITE TRADING ACADEMY — ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# --- SERVER ---
PORT=5000
NODE_ENV=development

# --- DATABASE ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/elite-trading-academy

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- RAZORPAY ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- EMAIL (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=info@elitetradingacademy.in
SMTP_PASSWORD=your_app_password
FROM_EMAIL=info@elitetradingacademy.in
FROM_NAME=ELITE Trading Academy

# --- WHATSAPP (WATI) ---
WATI_API_ENDPOINT=https://live-mt-server.wati.io/your_account
WATI_ACCESS_TOKEN=your_wati_access_token

# --- SMS OTP (MSG91) ---
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=ELITETR
MSG91_TEMPLATE_ID=your_template_id

# --- FRONTEND URL ---
CLIENT_URL=http://localhost:5173

# --- ADMIN ---
ADMIN_EMAIL=admin@elitetradingacademy.in
ADMIN_PASSWORD=Admin@Elite2024

# --- SESSION ---
SESSION_SECRET=your_session_secret_here
